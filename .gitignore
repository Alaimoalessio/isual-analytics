# Variabili d'ambiente — mai in Git
.env

# Ambienti virtuali Python
venv/
.venv/
env/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Test cache
.pytest_cache/

# Output generati (PDF report)
outputs/

# PDF nella root (documenti interni, non codice)
*.pdf

# Documenti Office non attinenti al progetto
*.xlsx
*.pptx

# Loghi: binari pesanti, da ottimizzare prima di versionarli
static/logos/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo
.env.production
.env.prod-admin
